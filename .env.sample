# Copy file này thành ".env" rồi chỉnh giá trị theo nhu cầu:
#   cp .env.sample .env
#
# Chọn 1 trong 4 engine bên dưới bằng cách set EMBEDDING_ENGINE,
# rồi chỉ điền phần biến tương ứng với engine đó.

# ============================================================
# EMBEDDING_ENGINE: "hash" | "ollama" | "voyage" | "openai"
# Mặc định nếu để trống: "hash" (không cần config gì thêm)
# ============================================================
EMBEDDING_ENGINE=ollama

# ---- Dùng khi EMBEDDING_ENGINE=ollama ----
# Không bắt buộc nếu bạn dùng đúng model/port mặc định.
OLLAMA_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434

# ---- Dùng khi EMBEDDING_ENGINE=voyage ----
# VOYAGE_API_KEY=your_voyage_api_key_here

# ---- Dùng khi EMBEDDING_ENGINE=openai ----
# OPENAI_API_KEY=your_openai_api_key_here
